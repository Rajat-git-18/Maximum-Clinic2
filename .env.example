# Public site URL used for canonical links, the sitemap, and Open Graph.
# Example: https://www.example-clinic.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 measurement ID. Google creates this when you add a web
# data stream at https://analytics.google.com (Admin → Data streams).
# It looks like G-XXXXXXXXXX. Leave this unset until that ID exists.
# The cookie notice stays hidden, and Analytics does not load, while it is empty.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional. When this is unset, the appointment form is a preview:
# it validates the request and then stops. Nothing is sent or stored.
# Use an HTTPS endpoint you control. Localhost is allowed for development.
# APPOINTMENT_INTAKE_URL=https://example.com/api/appointment-requests

# Optional bearer token. Sent only from the server, never to the browser.
# APPOINTMENT_INTAKE_SECRET=

# Staff desk login for appointments and career applications.
# In local development, defaults are username `staff` and password `MaximumStaff2026`
# if these are left unset. Set all three for production.
# STAFF_PASSWORD is the bootstrap password only. After a staff user changes their
# password in the desk, the new value is stored as a one-way hash in Upstash Redis
# (or data/staff-password.json locally). You do not need to edit Vercel env after that.
# To force a reset: delete the Redis key `mh:staff-password` (or the local JSON file)
# and sign in again with STAFF_PASSWORD.
# STAFF_USERNAME=staff
# STAFF_PASSWORD=
# STAFF_SESSION_SECRET=

# Upstash Redis for the staff inbox (appointments, careers, callbacks).
# Required on Vercel / serverless. Locally, if unset, data/staff-inbox.json is used.
# Create a free Redis database at https://console.upstash.com then paste both values.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
